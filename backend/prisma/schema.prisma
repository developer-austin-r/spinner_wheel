// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  roleName  String   @unique @map("role_name")
  slug      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id            Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  password      String
  phoneNumber   String?         @map("phone_number")
  roleId        Int             @map("role_id")
  role          Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  deletedAt     DateTime?       @map("deleted_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  SpinnerAmount SpinnerAmount[]
  Spinner       Spinner[]
  SelectedSpinnerValue SelectedSpinnerValue[]

  @@index([roleId])
  @@index([email])
  @@map("users")
}

model SpinnerAmount {
  id            Int       @id @default(autoincrement())
  spinner_name   String?
  spinner_amount Float?
  created_at     DateTime? @default(now())
  won_color      String?
  user_id        Int?
  updated_at     DateTime? @updatedAt
  deleted_at     DateTime?

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("spinner_amount")
}

model SpinnerColor {
  id        Int      @id @default(autoincrement())
  colorName String   @map("color_name")
  colorSlug String   @unique @map("color_slug")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  SelectedSpinnerValue SelectedSpinnerValue[]

  @@map("spinner_colors")
}

model Spinner {
  id           Int       @id @default(autoincrement())
  spinnerName  String    @map("spinner_name")
  baseAmount   Float     @map("base_amount")
  setAmount    Float     @map("set_amount")
  userId       Int?      @map("user_id")
  activeStatus Boolean   @default(true) @map("active_status")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  SelectedSpinnerValue SelectedSpinnerValue[]

  @@map("spinners")
}

model SelectedSpinnerValue {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  selectedColor Int           @map("selected_color")
  amount        String        @db.VarChar(255)
  spinnerId     Int           @map("spinner_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  color   SpinnerColor @relation(fields: [selectedColor], references: [id], onDelete: Cascade)
  spinner Spinner      @relation(fields: [spinnerId], references: [id], onDelete: Cascade)

  @@map("selected_spinner_values")
}
